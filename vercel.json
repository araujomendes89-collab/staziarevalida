{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/termos-de-uso",
      "destination": "/novo/termos",
      "permanent": false
    },
    {
      "source": "/politica-de-privacidade",
      "destination": "/novo/privacidade",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/novo/login",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/novo",
      "permanent": false
    },
    {
      "source": "/:path((?!api(?:/|$)|novo|assets/|brand/|ds-icons/|question-assets/|images/|temas/|mapas-mentais/|novo-assets/|\\.well-known/|_vercel/).+)",
      "destination": "/novo",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/novo",
      "destination": "/novo.html"
    },
    {
      "source": "/novo/:path*",
      "destination": "/novo.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/tutor/voice/sweep",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/play/cron",
      "schedule": "5 3 * * *"
    },
    {
      "path": "/api/planos/cron",
      "schedule": "15 11 * * *"
    },
    {
      "path": "/api/cobranca/cron",
      "schedule": "0 10 * * *"
    }
  ]
}
