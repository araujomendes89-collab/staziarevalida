{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/novo",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/novo/login",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/novo",
      "destination": "/novo.html"
    },
    {
      "source": "/novo/:path*",
      "destination": "/novo.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/tutor/voice/sweep",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/play/cron",
      "schedule": "5 3 * * *"
    }
  ]
}
