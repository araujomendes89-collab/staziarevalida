{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), usb=(), microphone=(self)" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/termos-de-uso",
      "destination": "/novo/termos",
      "permanent": false
    },
    {
      "source": "/politica-de-privacidade",
      "destination": "/novo/privacidade",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/novo/login",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/novo",
      "permanent": false
    },
    {
      "source": "/:path((?!api(?:/|$)|novo|assets/|brand/|ds-icons/|question-assets/|images/|temas/|mapas-mentais/|novo-assets/|\\.well-known/|_vercel/).+)",
      "destination": "/novo",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/novo",
      "destination": "/novo.html"
    },
    {
      "source": "/novo/:path*",
      "destination": "/novo.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/tutor/voice/sweep",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/play/cron",
      "schedule": "5 3 * * *"
    }
  ]
}
