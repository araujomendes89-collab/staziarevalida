{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/termos-de-uso",
      "destination": "/novo/termos",
      "permanent": false
    },
    {
      "source": "/politica-de-privacidade",
      "destination": "/novo/privacidade",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/novo/login",
      "permanent": false
    },
    {
      "source": "/:path((?!api(?:/|$)|novo|assets/|brand/|ds-icons/|question-assets/|images/|temas/|mapas-mentais/|novo-assets/|\\.well-known/|_vercel/|robots\\.txt$|sitemap\\.xml$|inicio-sem-js\\.css$).+)",
      "destination": "/novo",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/novo",
      "destination": "/novo.html"
    },
    {
      "source": "/novo/:path*",
      "destination": "/novo.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/tutor/voice/sweep",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/play/cron",
      "schedule": "5 3 * * *"
    },
    {
      "path": "/api/planos/cron",
      "schedule": "15 11 * * *"
    },
    {
      "path": "/api/cobranca/cron",
      "schedule": "0 * * * *"
    }
  ]
}
