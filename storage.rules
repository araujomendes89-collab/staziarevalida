rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Checking if the user is an admin by validating a document in Firestore
    function isAdmin() {
      return isAuthenticated() && (
        firestore.exists(/databases/staziamed-revalida-prod/documents/admins/$(request.auth.uid)) ||
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) ||
        (firestore.exists(/databases/staziamed-revalida-prod/documents/users/$(request.auth.uid)) &&
         firestore.get(/databases/staziamed-revalida-prod/documents/users/$(request.auth.uid)).data.role == 'ADMIN') ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );
    }

    match /questions-images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /source-pdfs/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
