rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Checking if the user is an admin by validating role == 'ADMIN' in named Firestore database
    function isAdmin() {
      return isAuthenticated() &&
        firestore.exists(/databases/staziamed-revalida-prod/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/staziamed-revalida-prod/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    match /questions-images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /content-engine/source-documents/{allPaths=**} {
      allow read, write: if isAdmin();
    }
    
    match /published-content/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
