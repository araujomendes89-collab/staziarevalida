{
  "name": "staziamed-revalida",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "revalida:validate-package": "tsx -e \"import { resolvePackageRoot, validateReverseEnginePackage } from './scripts/reverseEnginePackage.ts'; const root = resolvePackageRoot(); const result = validateReverseEnginePackage(root); console.log(JSON.stringify({ root, schema: result.manifest.schema_version, questions: result.questions.length, activeQuestions: result.manifest.active_question_count, editions: result.editions.length, assets: result.manifest.asset_count }, null, 2));\"",
    "revalida:import": "tsx scripts/import_reverse_engine_parallel.ts",
    "revalida:upload-assets": "tsx scripts/upload_reverse_engine_assets.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "ds:icons": "node scripts/design-system/sync-icons.mjs",
    "predev": "npm run ds:icons",
    "prebuild": "npm run ds:icons",
    "supabase:seed": "tsx scripts/supabase/build-seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@anthropic-ai/vertex-sdk": "^0.19.6",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "ts-fsrs": "^5.4.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "lucide-static": "^0.468.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.0"
  }
}
