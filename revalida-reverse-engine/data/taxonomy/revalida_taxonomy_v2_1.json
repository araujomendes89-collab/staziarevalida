  "classification_rules": [
    {
      "rule_id": "PSYCHIATRY_VS_PRIMARY_CARE_MENTAL_HEALTH",
      "rule": "Use CLINICAL_MEDICINE/PSYCHIATRY when the central task concerns psychiatric diagnosis, psychopathology, psychopharmacology, adverse effects or clinical treatment. Use FAMILY_COMMUNITY_PUBLIC_HEALTH/MENTAL_HEALTH_PRIMARY_CARE when the central task concerns longitudinal APS care, RAPS, CAPS, matriciamento, referral, territory or organization of the mental health network."
    },
    {
      "rule_id": "PEDIATRIC_VS_PUBLIC_HEALTH_IMMUNIZATION",
      "rule": "Use PEDIATRICS/IMMUNIZATION when the problem concerns vaccination of an individual child or adolescent. Use FAMILY_COMMUNITY_PUBLIC_HEALTH/IMMUNIZATION_PUBLIC_HEALTH when the central task concerns campaigns, coverage, population strategies, surveillance or immunization programs."
    },
    {
      "rule_id": "GERIATRICS",
      "rule": "Use GERIATRICS only when aging itself, geriatric syndromes, functional assessment, frailty, polypharmacy or an age-specific geriatric problem is central. Do not classify every older adult as geriatrics."
    },
    {
      "rule_id": "TRAUMA_CLASSIFICATION",
      "rule": "Use GENERAL_SURGERY/TRAUMA_ATLS for initial multisystem trauma assessment, stabilization and ATLS reasoning. Use GENERAL_SURGERY/ORTHOPEDICS_TRAUMA for predominantly isolated musculoskeletal injury or orthopedic management."
    },
    {
      "rule_id": "CLINICAL_EMERGENCY",
      "rule": "Prefer the organ-specific clinical subarea when the disease belongs clearly to one specialty. Use CLINICAL_EMERGENCIES when emergency stabilization, shock, poisoning, resuscitation or cross-system acute management is the central knowledge being tested."
    }
  ]
}