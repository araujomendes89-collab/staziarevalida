# GOOGLE CLOUD VERTEX AI & ANTHROPIC CONFIGURATION
# Direct Anthropic API Key (Claude Sonnet 3.7 / Opus)
ANTHROPIC_API_KEY=

# Or Google Cloud Vertex AI (Service Account ADC Authentication)
GOOGLE_CLOUD_PROJECT="staziamed-revalida-prod"
GOOGLE_CLOUD_LOCATION="southamerica-east1"
ANTHROPIC_VERTEX_PROJECT_ID="staziamed-revalida-prod"
CLOUD_ML_REGION="us-east5"
DEFAULT_AI_MODEL="gemini-3.7-flash"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE CONFIGURATION
VITE_FIREBASE_API_KEY="AIzaSyA0xv7NM9CSTBf5-lYd1_3KRMf1XzqUBjY"
VITE_FIREBASE_AUTH_DOMAIN="staziamed-revalida-prod.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="staziamed-revalida-prod"
VITE_FIREBASE_STORAGE_BUCKET="staziamed-revalida-prod.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="186513473712"
VITE_FIREBASE_APP_ID="1:186513473712:web:d7f1f2df30799938757b75"
VITE_FIREBASE_DATABASE_ID="staziamed-revalida-prod"

# ---------------------------------------------------------------------------
# Supabase (app novo em /novo e Central de Conteúdo)
#   SUPABASE_DB_URL e SUPABASE_SERVICE_ROLE_KEY são secretas: só no servidor, nunca com prefixo VITE_.
#   Com VITE_SUPABASE_URL e VITE_SUPABASE_ANON_KEY preenchidas, o app deixa o banco local e usa o Supabase.
# ---------------------------------------------------------------------------
SUPABASE_URL=""
SUPABASE_DB_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# Central de Conteúdo (servidor)
#   CONTENT_HUB_AI_PROVIDER: anthropic | gemini (mock só em desenvolvimento, com o banco local)
#   CONTENT_HUB_AI_ALLOW_EXTERNAL=1 autoriza enviar trechos dos PDFs ao provedor de IA
# ---------------------------------------------------------------------------
CONTENT_HUB_AI_PROVIDER=""
CONTENT_HUB_AI_ALLOW_EXTERNAL=""
CONTENT_HUB_ANTHROPIC_MODEL=""
CONTENT_HUB_GEMINI_MODEL=""
CONTENT_HUB_PRICE_INPUT_PER_MTOK=""
CONTENT_HUB_PRICE_OUTPUT_PER_MTOK=""
CONTENT_HUB_PYTHON=""
CONTENT_HUB_FONT_DIR=""
CONTENT_HUB_WORKER=""
# Esforço de raciocínio do conferente Anthropic (low|medium|high|xhigh|max); padrão medium
CONTENT_HUB_ANTHROPIC_EFFORT=""
# Provedor por papel de conferência (anthropic|gemini); o conferente nunca é da mesma família do criador
CONTENT_HUB_AI_PROVIDER_SOURCES=""
CONTENT_HUB_AI_PROVIDER_CURRENCY=""
CONTENT_HUB_AI_PROVIDER_REDTEAM=""

# ---------------------------------------------------------------------------
# Stazia Tutor (servidor)
#   TUTOR_AI_PROVIDER: anthropic | gemini | openai (mock só em desenvolvimento); TUTOR_MODEL opcional
#   TUTOR_AI_ALLOW_EXTERNAL=1 autoriza enviar a fala do aluno ao provedor de IA
#   Voz em tempo real (OpenAI Realtime, WebRTC; o navegador recebe só um segredo temporário):
#     OPENAI_REALTIME_MODEL: modelo de voz em tempo real (obrigatório para ligar a voz)
#     OPENAI_REALTIME_TRANSCRIBE_MODEL: opcional, transcrição da fala do aluno
#     usa OPENAI_API_KEY e TUTOR_VOICE_ALLOW_EXTERNAL=1
#   Voz do Gemini (português do Brasil nativo; preferida no automático quando houver chave; o navegador recebe só uma chave temporária):
#     GEMINI_LIVE_MODEL: opcional (padrão gemini-3.8-live); usa GEMINI_API_KEY ou GOOGLE_GEMINI_API_KEY e TUTOR_VOICE_ALLOW_EXTERNAL=1
#     OPENAI_VOICE_PROVIDER: opcional, gemini | live | realtime | auto (o painel do Tutor escolhe por cima)
#   AI_COST_CONFIG: opcional, JSON com preços por modelo (US$ por milhão de tokens) para a estimativa de custo
#   Voz natural antiga (TTS; só quando a voz em tempo real não está configurada):
#     TUTOR_VOICE_PROVIDER: openai | gemini | off
#     TUTOR_VOICE_ALLOW_EXTERNAL=1 autoriza enviar o texto das respostas ao serviço de voz
#     usa OPENAI_API_KEY ou GEMINI_API_KEY; TUTOR_VOICE_MODEL opcional
#     TUTOR_VOICE_DAILY_CHARS: teto de caracteres falados por aluno por dia (padrão 30000)
#     TUTOR_VOICE_PRICE_PER_MIN: preço por minuto de fala, para a estimativa de custo
# ---------------------------------------------------------------------------
TUTOR_AI_PROVIDER=""
TUTOR_AI_ALLOW_EXTERNAL=""
TUTOR_MODEL=""
OPENAI_REALTIME_MODEL=""
OPENAI_REALTIME_TRANSCRIBE_MODEL=""
GEMINI_LIVE_MODEL=""
OPENAI_VOICE_PROVIDER=""
AI_COST_CONFIG=""
TUTOR_VOICE_PROVIDER=""
TUTOR_VOICE_ALLOW_EXTERNAL=""
TUTOR_VOICE_MODEL=""
TUTOR_VOICE_DAILY_CHARS=""
OPENAI_API_KEY=""

# ---------------------------------------------------------------------------
# Podcasts (Ana e Bruno) e assistente de IA da "Nova aula" — ver docs/architecture/PODCASTS.md
#   Usam a mesma autorização da Central (CONTENT_HUB_AI_ALLOW_EXTERNAL=1) e as chaves acima:
#   ANTHROPIC_API_KEY (Claude), GEMINI_API_KEY ou GOOGLE_GEMINI_API_KEY (Gemini), OPENAI_API_KEY (+ CONTENT_HUB_OPENAI_MODEL no texto).
#   PODCAST_TTS_GEMINI_MODEL: voz de dois locutores do Gemini (padrão gemini-3.8-flash-tts)
#   PODCAST_TTS_OPENAI_MODEL: voz da OpenAI, uma por fala (padrão gpt-4o-mini-tts)
#   PODCAST_<GEMINI|ANTHROPIC|OPENAI>_MODEL e LESSON_ASSIST_<...>_MODEL: modelo de texto por provedor (opcional)
#   PODCAST_TTS_PRICE_PER_MIN: preço por minuto de voz, para a estimativa de custo
#   PODCASTS_STORAGE_DIR: pasta dos arquivos no desenvolvimento (padrão .data/podcasts)
# ---------------------------------------------------------------------------
GOOGLE_GEMINI_API_KEY=""
PODCAST_TTS_GEMINI_MODEL=""
PODCAST_TTS_OPENAI_MODEL=""
PODCAST_TTS_PRICE_PER_MIN=""
